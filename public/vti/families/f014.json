{"id":"f014","name":"Gray-Scott","chemicals":3,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"4\">\n    <description>\n      Self-replicating spots.\n      \n    </description>\n    <rule name=\"Gray-Scott\" type=\"formula\" wrap=\"1\" neighborhood_type=\"vertex\" neighborhood_range=\"1\" neighborhood_weight=\"laplacian\">\n      <param name=\"timestep\">\n        1\n      </param>\n      <param name=\"D_a\">\n        0.164\n      </param>\n      <param name=\"D_b\">\n        0.082\n      </param>\n      <param name=\"k\">\n        0.063\n      </param>\n      <param name=\"F\">\n        0.042\n      </param>\n      <param name=\"c_to_k\">\n        0\n      </param>\n      <param name=\"c_to_F\">\n        0.05\n      </param>\n      <param name=\"c_to_a\">\n        -0.005\n      </param>\n      <param name=\"c_to_b\">\n        -0.002\n      </param>\n      <param name=\"c_to_Da\">\n        0\n      </param>\n      <param name=\"c_to_Db\">\n        0\n      </param>\n      <param name=\"D_a_to_c\">\n        0\n      </param>\n      <param name=\"D_b_to_c\">\n        0\n      </param>\n      <param name=\"cDamp\">\n        0.00022\n      </param>\n      <param name=\"D_c\">\n        1e-05\n      </param>\n      <param name=\"a_to_c\">\n        0\n      </param>\n      <param name=\"b_to_c\">\n        0.0034\n      </param>\n      <param name=\"c_pow\">\n        0.9999\n      </param>\n      <param name=\"c_pow_norm\">\n        1\n      </param>\n      <formula number_of_chemicals=\"3\">\n                                        delta_a = (D_a + c*c_to_Da) * laplacian_a - a*b*b + (F+c_to_F*c)*(1.0f-a) + (c*c_to_a);\n        delta_b = (D_b  + c*c_to_Db) * laplacian_b + a*b*b - ((F+c_to_F*c)+(k+c*c_to_k))*b + (c*c_to_b);\n        delta_c = -c*cDamp + a*a_to_c + b*b_to_c + D_a_to_c * laplacian_a + D_b_to_c * laplacian_b + D_c * laplacian_c;\n        c = clamp( pow( fabs(c)/c_pow_norm, c_pow )*c_pow_norm, 0.0f, 1.0f );\n        \n      </formula>\n    </rule>\n    <initial_pattern_generator apply_when_loading=\"false\">\n      <overlay chemical=\"a\">\n        <overwrite>\n        </overwrite>\n        <constant value=\"0.7\">\n        </constant>\n        <everywhere>\n        </everywhere>\n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite>\n        </overwrite>\n        <white_noise low=\"0.01\" high=\"0.199\">\n        </white_noise>\n        <rectangle>\n          <point3D x=\"0.1\" y=\"0.1\" z=\"0.1\">\n          </point3D>\n          <point3D x=\"0.9\" y=\"0.9\" z=\"0.9\">\n          </point3D>\n        </rectangle>\n      </overlay>\n      <overlay chemical=\"a\">\n        <subtract>\n        </subtract>\n        <other_chemical chemical=\"b\">\n        </other_chemical>\n        <rectangle>\n          <point3D x=\"0.2\" y=\"0.2\" z=\"0.6\">\n          </point3D>\n          <point3D x=\"0.4\" y=\"0.5\" z=\"0.8\">\n          </point3D>\n        </rectangle>\n      </overlay>\n    </initial_pattern_generator>\n    <render_settings>\n      <surface_color r=\"1\" g=\"1\" b=\"1\">\n      </surface_color>\n      <color_low r=\"0\" g=\"0\" b=\"0\">\n      </color_low>\n      <color_high r=\"1\" g=\"1\" b=\"1\">\n      </color_high>\n      <show_color_scale value=\"false\">\n      </show_color_scale>\n      <show_multiple_chemicals value=\"false\">\n      </show_multiple_chemicals>\n      <active_chemical value=\"c\">\n      </active_chemical>\n      <low value=\"0\">\n      </low>\n      <high value=\"1\">\n      </high>\n      <vertical_scale_1D value=\"30\">\n      </vertical_scale_1D>\n      <vertical_scale_2D value=\"15\">\n      </vertical_scale_2D>\n      <contour_level value=\"0.25\">\n      </contour_level>\n      <use_wireframe value=\"false\">\n      </use_wireframe>\n      <show_cell_edges value=\"false\">\n      </show_cell_edges>\n      <show_bounding_box value=\"true\">\n      </show_bounding_box>\n      <slice_3D value=\"true\">\n      </slice_3D>\n      <slice_3D_axis value=\"z\">\n      </slice_3D_axis>\n      <slice_3D_position value=\"0.5\">\n      </slice_3D_position>\n      <show_displacement_mapped_surface value=\"false\">\n      </show_displacement_mapped_surface>\n      <color_displacement_mapped_surface value=\"true\">\n      </color_displacement_mapped_surface>\n      <use_image_interpolation value=\"true\">\n      </use_image_interpolation>\n      <timesteps_per_render value=\"128\">\n      </timesteps_per_render>\n      <show_phase_plot value=\"false\">\n      </show_phase_plot>\n      <phase_plot_x_axis value=\"a\">\n      </phase_plot_x_axis>\n      <phase_plot_y_axis value=\"b\">\n      </phase_plot_y_axis>\n      <phase_plot_z_axis value=\"c\">\n      </phase_plot_z_axis>\n    </render_settings>\n  </RD>\n  <ImageData WholeExtent=\"0 255 0 255 0 0\"></ImageData>\n</VTKFile>\n","representative":"cbd1e73f6d116426c53c0f352c38d699","presets":[{"name":"grayscott-evolvingMask-extra","path":"grayscott-sharpenTweak/grayscott-evolvingMask-extra.vti","md5":"f1719b1cb6bbe1c786e8893ef2ffc386","params":{"k":0.055,"F":0.018,"c_to_k":-0.004,"c_to_F":-0.003,"c_to_a":-0.003,"c_to_b":0.0,"c_to_Da":0.0,"D_a_to_c":0.0,"cDamp":0.0001,"D_c":0.02,"b_to_c":0.008,"c_pow":1.002,"c_pow_norm":1.0},"variant":0,"view":{"reagent":"b","low":0.0,"high":1.0,"stepsPerFrame":11.0},"seed":"synthetic","grid":[256,256],"thumb":true},{"name":"grayscott-evolvingMask-extra_flowyDots-gapTravellers","path":"grayscott-sharpenTweak/grayscott-evolvingMask-extra_flowyDots-gapTravellers.vti","md5":"1b4c3771adbe2c2d34779da50f578e11","params":{"k":0.063,"F":0.042,"c_to_k":-0.007,"c_to_F":0.05,"c_to_a":-0.005,"c_to_b":-0.002,"c_to_Da":0.0,"D_a_to_c":0.002,"cDamp":0.0007,"D_c":0.0005,"b_to_c":0.007,"c_pow":1.0001,"c_pow_norm":1.0},"variant":1,"view":{"reagent":"b","low":0.0,"high":1.0,"stepsPerFrame":11.0},"seed":"synthetic","grid":[256,256],"thumb":true},{"name":"grayscott-ev