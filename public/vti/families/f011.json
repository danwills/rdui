{"id":"f011","name":"Ginzburg-Landau","chemicals":3,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"2\">\n    <description>\n      The complex Ginzburg-Landau equation describes a vast variety of phenomena from nonlinear \nwaves to second-order phase transitions, from superconductivity, superfluidity, and \nBose-Einstein condensation to liquid crystals and strings in field theory. \n&lt;a href=&quot;http://hopf.chem.brandeis.edu/yanglingfa/pattern/cgle/index.html&quot;&gt;\n[link]&lt;/a&gt;\n    </description>\n    <rule name=\"Ginzburg-Landau\" type=\"formula\" wrap=\"1\">\n      <param name=\"timestep\">\n        0.2\n      </param>\n      <param name=\"alpha\">\n        0.0825\n      </param>\n      <param name=\"beta\">\n        0.75\n      </param>\n      <param name=\"delta\">\n        1.2\n      </param>\n      <param name=\"gamma\">\n        0.0625\n      </param>\n      <param name=\"D_a\">\n        0.15\n      </param>\n      <param name=\"D_b\">\n        0.1\n      </param>\n      <formula number_of_chemicals=\"3\">\n        delta_a = D_a * laplacian_a + alpha*a - gamma*b + (-beta*a + delta*b)*(a*a+b*b);\ndelta_b = D_b * laplacian_b + alpha*b + gamma*a + (-beta*b - delta*a)*(a*a+b*b);\nc = sqrt(a*a + b*b);\n      </formula>\n      \n    </rule>\n    <initial_pattern_generator apply_when_loading=\"true\">\n      <overlay chemical=\"a\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      \n    </initial_pattern_generator>\n    <render_settings>\n      <surface_color r=\"1\" g=\"1\" b=\"1\">\n        \n      </surface_color>\n      <color_low r=\"0\" g=\"0\" b=\"0\">\n        \n      </color_low>\n      <color_high r=\"1\" g=\"1\" b=\"1\">\n        \n      </color_high>\n      <show_color_scale value=\"false\">\n        \n      </show_color_scale>\n      <show_multiple_chemicals value=\"false\">\n        \n      </show_multiple_chemicals>\n      <active_chemical value=\"c\">\n        \n      </active_chemical>\n      <low value=\"0.19\">\n        \n      </low>\n      <high value=\"0.32\">\n        \n      </high>\n      <vertical_scale_1D value=\"30\">\n        \n      </vertical_scale_1D>\n      <vertical_scale_2D value=\"30\">\n        \n      </vertical_scale_2D>\n      <contour_level value=\"0\">\n        \n      </contour_level>\n      <use_wireframe value=\"false\">\n        \n      </use_wireframe>\n      <show_cell_edges value=\"false\">\n        \n      </show_cell_edges>\n      <show_bounding_box value=\"true\">\n        \n      </show_bounding_box>\n      <slice_3D value=\"true\">\n        \n      </slice_3D>\n      <slice_3D_axis value=\"z\">\n        \n      </slice_3D_axis>\n      <slice_3D_position value=\"0.5\">\n        \n      </slice_3D_position>\n      <show_displacement_mapped_surface value=\"false\">\n        \n      </show_displacement_mapped_surface>\n      <color_displacement_mapped_surface value=\"true\">\n        \n      </color_displacement_mapped_surface>\n      <use_image_interpolation value=\"true\">\n        \n      </use_image_interpolation>\n      <timesteps_per_render value=\"100\">\n        \n      </timesteps_per_render>\n      \n    </render_settings>\n    \n  </RD>\n  <ImageData WholeExtent=\"0 511 0 511 0 0\"></ImageData>\n</VTKFile>\n","representative":"42e7ad5cb79a1c24a8d7d4c5f091b585","presets":[{"name":"GL-magnitude","path":"GL-magnitude/GL-magnitude.vti","md5":"59c79324a06c2080bfcd14fdeb29a59c","params":{"timestep":0.2,"alpha