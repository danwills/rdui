{"id":"f019","name":"Ginzburg-Landau","chemicals":6,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"4\">\n    <description>\n                                                                                          The complex Ginzburg-Landau equation describes a vast variety of phenomena from nonlinear \nwaves to second-order phase transitions, from superconductivity, superfluidity, and \nBose-Einstein condensation to liquid crystals and strings in field theory. \n&lt;a href=&quot;http://hopf.chem.brandeis.edu/yanglingfa/pattern/cgle/index.html&quot;&gt;\n[link]&lt;/a&gt;\n    </description>\n    <rule name=\"Ginzburg-Landau\" type=\"formula\" wrap=\"1\" neighborhood_type=\"vertex\" neighborhood_range=\"1\" neighborhood_weight=\"laplacian\">\n      <param name=\"timestep\">\n        0.1\n      </param>\n      <param name=\"alpha\">\n        0.082\n      </param>\n      <param name=\"beta\">\n        0.8\n      </param>\n      <param name=\"delta\">\n        1.31\n      </param>\n      <param name=\"gamma\">\n        0.0799\n      </param>\n      <param name=\"D_a\">\n        0.375\n      </param>\n      <param name=\"D_b\">\n        0.0035\n      </param>\n      <param name=\"mag_amp\">\n        1.1\n      </param>\n      <param name=\"mag_power\">\n        1\n      </param>\n      <param name=\"mag_zeroPt\">\n        0\n      </param>\n      <param name=\"mag_to_Da\">\n        -1\n      </param>\n      <param name=\"mag_to_Db\">\n        1.5\n      </param>\n      <param name=\"mag_to_gamma\">\n        0.5\n      </param>\n      <param name=\"wave_diffusion\">\n        0.003\n      </param>\n      <param name=\"wave_damp\">\n        0.9998\n      </param>\n      <param name=\"wave_power\">\n        1\n      </param>\n      <param name=\"wave_clamp_min\">\n        -2\n      </param>\n      <param name=\"wave_clamp_max\">\n        2\n      </param>\n      <param name=\"a_to_wave\">\n        -0.0005\n      </param>\n      <param name=\"b_to_wave\">\n        0.0005\n      </param>\n      <param name=\"c_to_wave\">\n        0\n      </param>\n      <param name=\"wave_to_a\">\n        0.04\n      </param>\n      <param name=\"wave_to_b\">\n        -0.02\n      </param>\n      <param name=\"wave_to_alpha\">\n        0.02\n      </param>\n      <param name=\"wave_to_beta\">\n        0\n      </param>\n      <param name=\"wave_to_delta\">\n        0\n      </param>\n      <param name=\"wave_to_gamma\">\n        0.08751\n      </param>\n      <param name=\"wave_to_Da\">\n        0\n      </param>\n      <param name=\"wave_to_Db\">\n        0.03\n      </param>\n      <param name=\"a_to_history\">\n        -0.003\n      </param>\n      <param name=\"b_to_history\">\n        0\n      </param>\n      <param name=\"c_complement_prediv\">\n        0.08\n      </param>\n      <param name=\"complement_c_to_history\">\n        0.004\n      </param>\n      <param name=\"history_damp\">\n        0.002\n      </param>\n      <param name=\"history_diffusion\">\n        0.0001\n      </param>\n      <param name=\"history_pow\">\n        1\n      </param>\n      <param name=\"history_pow_norm\">\n        1\n      </param>\n      <param name=\"history_clamp_min\">\n        -1\n      </param>\n      <param name=\"history_clamp_max\">\n        1\n      </param>\n      <formula number_of_chemicals=\"6\">\n                delta_a = (c*mag_to_Da + d*wave_to_Da + D_a) * laplacian_a + (alpha + d*wave_to_alpha)*a - (gamma + c*mag_to_gamma + d*wave_to_gamma)*b + (-(beta + d*wave_to_beta)*a + (delta + d*wave_to_delta)*b)*(a*a+b*b) + d*wave_to_a;\ndelta_b = (c * mag_to_Db + d*wave_to_Db + D_b) * laplacian_b + (alpha + d*wave_to_alpha)*b + (gamma + c*mag_to_gamma + d*wave_to_gamma)*a + (-(beta + d*wave_to_beta)*b - (delta + d*wave_to_delta)*a)*(a*a+b*b) + d * wave_to_b;\nc = pow(a*a + b*b, mag_power) * mag_amp + mag_zeroPt;\nd = clamp( sign(d) * pow( fabs(d) * wave_damp, wave_power ) + a * a_to_wave + b * b_to_wave + c * c_to_wave, wave_clamp_min, wave_clamp_max);\ndelta_e = laplacian_d * wave_diffusion;\ndelta_d = e + delta_e;\n// f = clamp( pow( (float4)( fabs(f)/history_pow_norm ), (float4)history_pow )*history_pow_norm, history_clamp_min, history_clamp_max );\nf = clamp( f, history_clamp_min, history_clamp_max );\ndelta_f = -f*history_damp + a*a_to_history + b*b_to_history + (1.0f-c/c_complement_prediv)*complement_c_to_history + history_diffusion * laplacian_f;\n      </formula>\n      \n    </rule>\n    <initial_pattern_generator apply_when_loading=\"false\">\n      <overlay chemical=\"a\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      \n    </initial_pattern_generator>\n    <render_settings>\n      <surface_color r=\"1\" g=\"1\" b=\"1\">\n        \n      </surface_color>\n      <color_low r=\"0\" g=\"0\" b=\"0\">\n        \n      </color_low>\n      <color_high r=\"1\" g=\"1\" b=\"1\">\n        \n      </color_high>\n      <show_color_scale value=\"false\">\n        \n      </show_color_scale>\n      <show_multiple_chemicals value=\"true\">\n        \n      </show_multiple_chemicals>\n      <active_chemical value=\"a\">\n        \n      </active_chemical>\n      <low value=\"-0.42\">\n        \n      </low>\n      <high value=\"0.42\">\n        \n      </high>\n      <vertical_scale_1D value=\"30\">\n        \n      </vertical_scale_1D>\n      <vertical_scale_2D value=\"30\">\n        \n      </vertical_scale_2D>\n      <contour_level value=\"0\">\n        \n      </contour_level>\n      <use_wireframe value=\"false\">\n        \n      </use_wireframe>\n      <show_cell_edges value=\"false\">\n        \n      </show_cell_edges>\n      <show_bounding_box value=\"true\">\n        \n      </show_bounding_box>\n      <slice_3D value=\"true\">\n        \n      </slice_3D>\n      <slice_3D_axis value=\"z\">\n        \n      </slice_3D_axis>\n      <slice_3D_position value=\"0.5\">\n        \n      </slice_3D_position>\n      <show_displacement_mapped_surface value=\"false\">\n        \n      </show_displacement_mapped_surface>\n      <color_displacement_mapped_surface value=\"true\">\n        \n      </color_displacement_mapped_surface>\n      <use_image_interpolation value=\"true\">\n        \n      </use_image_interpolation>\n      <timesteps_per_render value=\"77\">\n        \n      </timesteps_per_render>\n      <show_phase_plot value=\"false\">\n        \n      </show_phase_plot>\n      <phase_plot_x_axis value=\"a\">\n        \n      </phase_plot_x_axis>\n      <phase_plot_y_axis value=\"b\">\n        \n      </phase_plot_y_axis>\n      <phase_plot_z_axis value=\"c\">\n        \n      </phase_plot_z_axis>\n      \n    </render_settings>\n    \n  </RD>\n  <ImageData WholeExtent=\"0 255 0 255 0 0\"></ImageData>\n</VTKFile>\n","representative":"3d32c7533c6c19c4e32d9dfbd6b28d2d","presets":[{"name":"GL-magnitude-waveAndhistoryCoupling_setup2_vigorous","path":"GL-magnitude/GL-magnitude-waveAndhistoryCoupling_setup2_vigorous.vti","md5":"107c8ddab9b0b9ccd29a67cea8191eb1","params":{"timestep":0.1,"beta":0.8,"delta":1.31,"gamma":0.0799,"D_b":0.0035,"mag_power":1.0,"mag_to_Da":-1.0,"mag_to_Db":1.5,"mag_to_gamma":0.5,"wave_diffusion":0.003,"wave_damp":0.999,"wave_power":1.0,"wave_clamp_min":-2.0,"wave_clamp_max":2.0,"a_to_wave":-0.0005,"b_to_wave":0.0005,"c_to_wave":0.0,"wave_to_a":0.0,"wave_to_b":0.01,"wave_to_alpha":0.0,"wave_to_delta":0.0,"wave_to_gamma":0.0,"wave_to_Da":0.0,"wave_to_Db":0.0,"a_to_history":-0.003,"b_to_history":0.0,