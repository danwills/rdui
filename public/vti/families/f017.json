{"id":"f017","name":"Ginzburg-Landau","chemicals":2,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"2\">\n      \n    <description>\n        &quot;The complex Ginzburg-Landau equation describes a vast variety of phenomena from nonlinear \n        waves to second-order phase transitions, from superconductivity, superfluidity, and \n        Bose-Einstein condensation to liquid crystals and strings in field theory.&quot; \n        &lt;a href=&quot;http://hopf.chem.brandeis.edu/yanglingfa/pattern/cgle/index.html&quot;&gt;\n        [link]&lt;/a&gt;\n    </description>\n      \n    <rule type=\"formula\" name=\"Ginzburg-Landau\">\n        \n      <param name=\"timestep\"> 0.2     </param>\n      <param name=\"alpha\">    0.0625  </param>\n      <param name=\"beta\">     1.0     </param>\n      <param name=\"delta\">    1.0     </param>\n      <param name=\"gamma\">    0.0625  </param>\n      <param name=\"D_a\">      0.2     </param>\n      <param name=\"D_b\">      0.2     </param>\n      \n      <formula number_of_chemicals=\"2\">\n          delta_a = D_a * laplacian_a + alpha*a - gamma*b + (-beta*a + delta*b)*(a*a+b*b);\n          delta_b = D_b * laplacian_b + alpha*b + gamma*a + (-beta*b - delta*a)*(a*a+b*b);\n      </formula>\n      \n    </rule>\n    \n    <initial_pattern_generator apply_when_loading=\"true\">\n      <overlay chemical=\"a\">\n        <overwrite />\n        <white_noise low=\"-0.1\" high=\"0.1\" />\n        <everywhere />\n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite />\n        <white_noise low=\"-0.1\" high=\"0.1\" />\n        <everywhere />\n      </overlay>\n    </initial_pattern_generator>\n    \n    <render_settings>\n      <low value=\"-0.25\" />\n      <high value=\"0.25\" />\n      <show_displacement_mapped_surface value=\"false\" />\n      <show_multiple_chemicals value=\"false\" />\n      <color_low r=\"0\" g=\"0\" b=\"0\" />\n      <color_high r=\"1\" g=\"1\" b=\"1\" />\n      <timesteps_per_render value=\"10\" />\n      <vertical_scale_2D value=\"30\" />\n      <contour_level value=\"0\" />\n    </render_settings>\n\n  </RD>\n  <ImageData WholeExtent=\"0 255 0 255 0 0\"></ImageData>\n</VTKFile>\n","representative":"b83c58b5a76b279bcd82d9f8b90a2c8e","presets":[{"name":"complex_Ginsburg-Landau","path":"complex_Ginsburg-Landau.vti","md5":"b83c58b5a76b279bcd82d9f8b90a2c8e","params":{"timestep":0.2,"alpha":0.0625,"beta":1.0,"delta":1.0,"gamma":0.0625,"D_a":0.2,"D_b":0.2},"variant":0,"view":{"low":-0.25,"high":0.25,"stepsPerFrame":10.0},"seed":null,"grid":[256,256],"thumb":true},{"name":"complex_Ginzburg-Landau","path":"Ginzburg-Landau/complex_Ginzburg-Landau.vti","md5":"f41364875dd7850afe6f90aec3dc42d6","params":{"timestep":0.2,"alpha":0.0625,"beta":1.0,"delta":1.0,"gamma":0.0625,"D_a":0.2,"D_b":0.2},"variant":0,"view":{"low":-0.25,"high":0.25,"stepsPerFrame":10.0},"seed":null,"grid":[256,256],"thumb":true},{"name":"complex_Ginsburg-Landau_bio_djw","path":"cglrd/complex_Ginsburg-Landau_bio_djw.vti","md5":"7a9528623aa7d59134dc1fd6d8bc49ea","params":{"timestep":0.2,"alpha":0.076,"beta":0.8,"delta":1.11,"gamma":0.0899,"D_a":0.33,"D_b":0.051},"variant":1,"view":{"reagent":"a","low":-0.3,"high":0.3,"stepsPerFrame":128.0},"seed":null,"grid":[256,256],"thumb":false},{"name":"complex_Ginsburg-Landau_chaoMush_djw","path":"cglrd/complex_Ginsburg-Landau_chaoMush_djw.vti","md5":"a00694373e29d76bc1cf00575e349b5f","params":{"timestep":0.02,"alpha":0.817,"beta":1.39,"delta":-1.01,"gamma":-0.6,"D_a":0.2,"D_b":0.2},"variant":2,"view":{"reagent":"a","low":-0.6,"high":0.6,"stepsPerFrame":77.0},"seed":null,"grid":[128,128],"thumb":true},{"name":"complex_Ginsburg-Landau_chaoShrooms_djw","path":"cglrd/complex_Ginsburg-Landau_chaoShrooms_djw.vti","md5":"ff1466ba6d89276a32f0e21599f23fb8","params":{"timestep":0.01,"alpha":0.5,"beta":0.22,"delta":0.3,"gamma":0.4,"D_a":0.2,"D_b":0.8},"v