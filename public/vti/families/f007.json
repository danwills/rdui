{"id":"f007","name":"Orbit","chemicals":4,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"3\">\n    <description>\n                                                                        This is a test of an rd that uses an iteration step implemented to treat reagents a and b as a complex number (a+bi) and raising it to a power.;\n[link]&lt;/a&gt;\n    </description>\n    <rule name=\"Orbit\" type=\"formula\" wrap=\"1\" neighborhood_type=\"vertex\" neighborhood_range=\"1\" neighborhood_weight=\"laplacian\">\n      <param name=\"timestep\">\n        0.02\n      </param>\n      <param name=\"clampMin\">\n        -1.5\n      </param>\n      <param name=\"clampMax\">\n        1.5\n      </param>\n      <param name=\"constReal\">\n        0.09\n      </param>\n      <param name=\"constImag\">\n        -0.01\n      </param>\n      <param name=\"realPower\">\n        2.5\n      </param>\n      <param name=\"imagPower\">\n        0.02\n      </param>\n      <param name=\"D_a\">\n        1\n      </param>\n      <param name=\"D_b\">\n        1.6\n      </param>\n      <param name=\"mag_amp\">\n        0.2\n      </param>\n      <param name=\"mag_power\">\n        1.5\n      </param>\n      <param name=\"mag_add\">\n        0.005\n      </param>\n      <param name=\"phase_offset\">\n        -0.02\n      </param>\n      <param name=\"phase_scale\">\n        1\n      </param>\n      <formula number_of_chemicals=\"4\">\n                                                c = pow(a*a + b*b, mag_power) * mag_amp + mag_add;\nd = atan2( b, a ) * phase_scale + phase_offset;\ndelta_a = clamp( timestep * pow( c, realPower) * pow( 2.718281828459045235360287471352f, -imagPower*d ) * cos( imagPower * log( c ) + realPower * d ) + D_a * laplacian_a + constReal, clampMin, clampMax );\ndelta_b = clamp( timestep * pow( c, realPower) * pow( 2.718281828459045235360287471352f, -imagPower*d ) * sin( imagPower * log( c ) + realPower * d ) + D_b * laplacian_b + constImag, clampMin, clampMax );\n      </formula>\n      \n    </rule>\n    <initial_pattern_generator apply_when_loading=\"false\">\n      <overlay chemical=\"a\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"-0.1\" high=\"0.1\">\n          \n        </white_noise>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      \n    </initial_pattern_generator>\n    <render_settings>\n      <surface_color r=\"1\" g=\"1\" b=\"1\">\n        \n      </surface_color>\n      <color_low r=\"0\" g=\"0\" b=\"0\">\n        \n      </color_low>\n      <color_high r=\"1\" g=\"1\" b=\"1\">\n        \n      </color_high>\n      <show_color_scale value=\"false\">\n        \n      </show_color_scale>\n      <show_multiple_chemicals value=\"true\">\n        \n      </show_multiple_chemicals>\n      <active_chemical value=\"a\">\n        \n      </active_chemical>\n      <low value=\"-3\">\n        \n      </low>\n      <high value=\"3\">\n        \n      </high>\n      <vertical_scale_1D value=\"30\">\n        \n      </vertical_scale_1D>\n      <vertical_scale_2D value=\"30\">\n        \n      </vertical_scale_2D>\n      <contour_level value=\"0\">\n        \n      </contour_level>\n      <use_wireframe value=\"false\">\n        \n      </use_wireframe>\n      <show_cell_edges value=\"false\">\n        \n      </show_cell_edges>\n      <show_bounding_box value=\"true\">\n        \n      </show_bounding_box>\n      <slice_3D value=\"true\">\n        \n      </slice_3D>\n      <slice_3D_axis value=\"z\">\n        \n      </slice_3D_axis>\n      <slice_3D_position value=\"0.5\">\n      