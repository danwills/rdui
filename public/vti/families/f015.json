{"id":"f015","name":"Gray-Scott","chemicals":5,"header":"<?xml version=\"1.0\"?>\n<VTKFile type=\"ImageData\" version=\"0.1\" byte_order=\"LittleEndian\" compressor=\"vtkZLibDataCompressor\">\n  <RD format_version=\"3\">\n    <description>\n      Self-replicating spots.\n    </description>\n    <rule name=\"Gray-Scott\" type=\"formula\" wrap=\"1\" neighborhood_type=\"vertex\" neighborhood_range=\"1\" neighborhood_weight=\"laplacian\">\n      <param name=\"timestep\">\n        1\n      </param>\n      <param name=\"D_a\">\n        0.164\n      </param>\n      <param name=\"D_b\">\n        0.082\n      </param>\n      <param name=\"k\">\n        0.063\n      </param>\n      <param name=\"F\">\n        0.042\n      </param>\n      <param name=\"c_to_k\">\n        0\n      </param>\n      <param name=\"c_to_F\">\n        0.05\n      </param>\n      <param name=\"c_to_a\">\n        -0.005\n      </param>\n      <param name=\"c_to_b\">\n        -0.002\n      </param>\n      <param name=\"c_to_Da\">\n        0\n      </param>\n      <param name=\"c_to_Db\">\n        0\n      </param>\n      <param name=\"D_a_to_c\">\n        0\n      </param>\n      <param name=\"D_b_to_c\">\n        0\n      </param>\n      <param name=\"cDamp\">\n        0.0003\n      </param>\n      <param name=\"D_c\">\n        0.01\n      </param>\n      <param name=\"a_to_c\">\n        0\n      </param>\n      <param name=\"b_to_c\">\n        0.004\n      </param>\n      <param name=\"c_pow\">\n        1\n      </param>\n      <param name=\"c_pow_norm\">\n        1\n      </param>\n      <param name=\"wave_diffusion\">\n        0.0005\n      </param>\n      <param name=\"wave_damp\">\n        0.998\n      </param>\n      <param name=\"wave_power\">\n        1\n      </param>\n      <param name=\"a_wave\">\n        0\n      </param>\n      <param name=\"b_wave\">\n        0.01\n      </param>\n      <param name=\"c_wave\">\n        0\n      </param>\n      <param name=\"wave_to_F\">\n        0.01\n      </param>\n      <param name=\"wave_to_k\">\n        -0.003\n      </param>\n      <param name=\"wave_to_Da\">\n        -0.02\n      </param>\n      <param name=\"wave_to_Db\">\n        -0.02\n      </param>\n      <param name=\"wave_to_a\">\n        0\n      </param>\n      <param name=\"wave_to_b\">\n        0\n      </param>\n      <formula number_of_chemicals=\"5\">\n                        delta_a = (D_a + c*c_to_Da + d*wave_to_Da) * laplacian_a - a*b*b + (F + c_to_F*c + d*wave_to_F)*(1.0f-a) + c*c_to_a + d*wave_to_a;\ndelta_b = (D_b  + c*c_to_Db + d*wave_to_Db) * laplacian_b + a*b*b - ((F + c_to_F*c + d*wave_to_F)+(k + c*c_to_k + d*wave_to_k))*b + c*c_to_b + d*wave_to_b;\ndelta_c = -c*cDamp + a*a_to_c + b*b_to_c + D_a_to_c * laplacian_a + D_b_to_c * laplacian_b + D_c * laplacian_c;\nc = clamp( pow( fabs(c)/c_pow_norm, c_pow )*c_pow_norm, 0.0f, 1.0f );\nd = sign(d) * pow( fabs(d) * wave_damp, wave_power ) + a * a_wave + b * b_wave + c * c_wave;\ndelta_e = laplacian_d * wave_diffusion;\ndelta_d = e + delta_e;\n      </formula>\n      \n    </rule>\n    <initial_pattern_generator apply_when_loading=\"false\">\n      <overlay chemical=\"a\">\n        <overwrite>\n          \n        </overwrite>\n        <constant value=\"0.7\">\n          \n        </constant>\n        <everywhere>\n          \n        </everywhere>\n        \n      </overlay>\n      <overlay chemical=\"b\">\n        <overwrite>\n          \n        </overwrite>\n        <white_noise low=\"0.01\" high=\"0.199\">\n          \n        </white_noise>\n        <rectangle>\n          <point3D x=\"0.1\" y=\"0.1\" z=\"0.1\">\n            \n          </point3D>\n          <point3D x=\"0.9\" y=\"0.9\" z=\"0.9\">\n            \n          </point3D>\n          \n        </rectangle>\n        \n      </overlay>\n      <overlay chemical=\"a\">\n        <subtract>\n          \n        </subtract>\n        <other_chemical chemical=\"b\">\n          \n        </other_chemical>\n        <rectangle>\n          <point3D x=\"0.2\" y=\"0.2\" z=\"0.6\">\n            \n          </point3D>\n          <point3D x=\"0.4\" y=\"0.5\" z=\"0.8\">\n            \n          </point3D>\n          \n        </rectangle>\n        \n      </overlay>\n      \n    </initial_pattern_generator>\n    <render_settings>\n      <surface_color r=\"1\" g=\"1\" b=\"1\">\n        \n      </surface_color>\n      <color_low r=\"0\" g=\"0\" b=\"0\">\n        \n      </color_low>\n      <color_high r=\"1\" g=\"1\" b=\"1\">\n        \n      </color_high>\n      <show_color_scale value=\"false\">\n        \n      </show_color_scale>\n      <show_multiple_chemicals value=\"true\">\n        \n      </show_multiple_chemicals>\n      <active_chemical value=\"b\">\n        \n      </active_chemical>\n      <low value=\"0\">\n        \n      </low>\n      <high value=\"1\">\n        \n      </high>\n      <vertical_scale_1D value=\"30\">\n        \n      </vertical_scale_1D>\n      <vertical_scale_2D value=\"15\">\n        \n      </vertical_scale_2D>\n      <contour_level value=\"0.25\">\n        \n      </contour_level>\n      <use_wireframe value=\"false\">\n        \n      </use_wireframe>\n      <show_cell_edges value=\"false\">\n        \n      </show_cell_edges>\n      <show_bounding_box value=\"true\">\n        \n      </show_bounding_box>\n      <slice_3D value=\"true\">\n        \n      </slice_3D>\n      <slice_3D_axis value=\"z\">\n        \n      </slice_3D_axis>\n      <slice_3D_position value=\"0.5\">\n        \n      </slice_3D_position>\n      <show_displacement_mapped_surface value=\"false\">\n        \n      </show_displacement_mapped_surface>\n      <color_displacement_mapped_surface value=\"true\">\n        \n      </color_displacement_mapped_surface>\n      <use_image_interpolation value=\"true\">\n        \n      </use_image_interpolation>\n      <timesteps_per_render value=\"66\">\n        \n      </timesteps_per_render>\n      \n    </render_settings>\n    \n  </RD>\n  <ImageData WholeExten