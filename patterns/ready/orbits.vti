<?xml version="1.0"?>
<VTKFile type="ImageData" version="0.1" byte_order="LittleEndian" compressor="vtkZLibDataCompressor">
  <RD format_version="3">
    <description>
      This is an rd formula that uses an iteration step implemented to treat reagents a and b as a complex number (a+bi) and raise it to a power. Inspired by what a normal orbits-fractal (eg Julia, Mandelbrot) step does.;
[link]&lt;/a&gt;
    </description>
    <rule name="Orbit" type="formula" wrap="1" neighborhood_type="vertex" neighborhood_range="1" neighborhood_weight="laplacian">
      <param name="timestep">
        0.05
      </param>
      <param name="clampMin">
        -2
      </param>
      <param name="clampMax">
        2
      </param>
      <param name="constReal">
        -0.05
      </param>
      <param name="constImag">
        0.04
      </param>
      <param name="realPower">
        1
      </param>
      <param name="imagPower">
        -1
      </param>
      <param name="D_a">
        0.14
      </param>
      <param name="D_b">
        0.08
      </param>
      <param name="mag_amp">
        4
      </param>
      <param name="mag_power">
        2
      </param>
      <param name="mag_zeroPt">
        1
      </param>
      <param name="phaseOffset">
        0.5
      </param>
      <param name="phaseAmp">
        0.85
      </param>
      <formula number_of_chemicals="2">
                                delta_a = clamp( timestep * pow( pow(a*a + b*b, mag_power) * mag_amp + mag_zeroPt, realPower) * pow( 2.718281828459045235360287471352, -imagPower*(atan2( b, a ) * phaseAmp + phaseOffset) ) * cos( imagPower * log( pow(a*a + b*b, mag_power) * mag_amp + mag_zeroPt ) + realPower * atan2( b, a ) * phaseAmp + phaseOffset ) + D_a * laplacian_a + constReal, clampMin, clampMax );
delta_b = clamp( timestep * pow( pow(a*a + b*b, mag_power) * mag_amp + mag_zeroPt, realPower) * pow( 2.718281828459045235360287471352, -imagPower*(atan2( b, a ) * phaseAmp + phaseOffset) ) * sin( imagPower * log( pow(a*a + b*b, mag_power) * mag_amp + mag_zeroPt ) + realPower * atan2( b, a ) * phaseAmp + phaseOffset ) + D_b * laplacian_b + constImag, clampMin, clampMax );
      </formula>
      
    </rule>
    <initial_pattern_generator apply_when_loading="false">
      <overlay chemical="a">
        <overwrite>
          
        </overwrite>
        <white_noise low="0.8" high="2.75">
          
        </white_noise>
        <rectangle>
          <point3D x="0.3" y="0.39" z="0.75">
            
          </point3D>
          <point3D x="0.34" y="0.4" z="0.72">
            
          </point3D>
          
        </rectangle>
        
      </overlay>
      <overlay chemical="b">
        <overwrite>
          
        </overwrite>
        <white_noise low="-19.6" high="1.8">
          
        </white_noise>
        <rectangle>
          <point3D x="0.2" y="0.9" z="0.2">
            
          </point3D>
          <point3D x="0.8" y="0.1" z="0.8">
            
          </point3D>
          
        </rectangle>
        
      </overlay>
      
    </initial_pattern_generator>
    <render_settings>
      <surface_color r="1" g="1" b="1">
        
      </surface_color>
      <color_low r="0" g="0" b="0">
        
      </color_low>
      <color_high r="1" g="1" b="1">
        
      </color_high>
      <show_color_scale value="false">
        
      </show_color_scale>
      <show_multiple_chemicals value="false">
        
      </show_multiple_chemicals>
      <active_chemical value="a">
        
      </active_chemical>
      <low value="-2">
        
      </low>
      <high value="2">
        
      </high>
      <vertical_scale_1D value="30">
        
      </vertical_scale_1D>
      <vertical_scale_2D value="30">
        
      </vertical_scale_2D>
      <contour_level value="0">
        
      </contour_level>
      <use_wireframe value="false">
        
      </use_wireframe>
      <show_cell_edges value="false">
        
      </show_cell_edges>
      <show_bounding_box value="true">
        
      </show_bounding_box>
      <slice_3D value="true">
        
      </slice_3D>
      <slice_3D_axis value="z">
        
      </slice_3D_axis>
      <slice_3D_position value="0.5">
        
      </slice_3D_position>
      <show_displacement_mapped_surface value="false">
        
      </show_displacement_mapped_surface>
      <color_displacement_mapped_surface value="true">
        
      </color_displacement_mapped_surface>
      <use_image_interpolation value="true">
        
      </use_image_interpolation>
      <timesteps_per_render value="1407">
        
      </timesteps_per_render>
      
    </render_settings>
    
  </RD>
  <ImageData WholeExtent="0 511 0 511 0 0" Origin="0 0 0" Spacing="1 1 1">
  <Piece Extent="0 511 0 511 0 0">
    <PointData>
      <DataArray type="Float32" Name="a" format="binary" RangeMin="0" RangeMax="2.7439434528">
        
      </DataArray>
      <DataArray type="Float32" Name="b" format="binary" RangeMin="0" RangeMax="0">
        
      </DataArray>
    </PointData>
    <CellData>
